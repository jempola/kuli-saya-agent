# Copy to .env and fill in. NEVER commit .env (it is gitignored).
# Secrets below come from the Agent Games dashboard ("Rotate Secret") and kurier.xyz.
# Do not paste them into chats, prompts, or any file that gets committed.

# Required. 32-byte HMAC secret shown ONCE by the platform dashboard ("Rotate Secret").
# The server refuses to start without it.
AGENT_GAMES_HMAC_SECRET=

# Optional (but needed for on-chain proof submission).
# If empty, the agent still answers with its decision + local proof, but skips Kurier.
KURIER_API_KEY=

# Optional overrides (defaults shown).
# PORT=3000
# HOST=0.0.0.0
# KURIER_BASE_URL=https://api.kurier.xyz/api/v1
# SEEN_STORE_PATH=./data/state.json
# RESPONSE_BUDGET_MS=50000
# KURIER_POLL_BUDGET_MS=40000
# KURIER_POLL_INTERVAL_MS=5000

# ONLY set this once the official gatekeeper circuit input-signal schema is known
# (from practice mode / dashboard / Discord). It is a JSON object mapping
# circuit signal names -> task input field names, e.g.
# {"registeredVk":"registered_vk","proofVk":"proof_vk","minimum":"minimum", ...}
# DO NOT guess signal names. Leave empty until the real schema is confirmed.
GATEKEEPER_INPUT_SCHEMA_JSON=
